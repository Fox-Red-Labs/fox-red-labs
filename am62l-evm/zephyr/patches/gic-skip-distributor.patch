+config GIC_SKIP_DISTRIBUTOR
+	bool "Never program the GIC distributor (another OS owns it)"
+	depends on GIC_V3
+	help
+	  Skip gicv3_dist_init() entirely: no GICD_CTLR write, no SPI group, priority,
+	  trigger or enable programming. Only this core redistributor wake, the CPU
+	  interface (ICC_* registers) and the SGI/PPI registers in its own redistributor
+	  are touched. For a second OS on another core that must not disturb the first.
+	  Unlike GIC_SAFE_CONFIG this does not look at GICD_CTLR at run time.
+
 config GIC_SAFE_CONFIG
 	bool "GIC Distributor Safe Configuration"
 	depends on GIC
