// AM62L EVM as Renode sees it, for the bare-EL3 SRAM Zephyr image (experiment E208).
// Generated 2026-10-18 by dts2repl from build-sram-all/zephyr/zephyr.dts (upstream Zephyr a915b2f plus
// am62l-evm/zephyr/sram-all.overlay), then one edit: the generic timer frequency. Everything Renode has no model
// for is a Tag (reads return 0, writes are logged), which is what makes the run functional, not accurate:
// no clock tree, no ROM, no TIFS, no timing. What it checks: EL3 entry, MMU tables, GICv3, the 16550 at
// 0x02800000 and the 0x707F0000 SRAM map. Run: run.sh on the Mac mini.
sysbus:
    init:
        Tag <0x9180000 0x80000> "main_mmr_cfg3"
        Tag <0x1820000 0x10000> "its"
        Tag <0x70800000 0x10000> "scmi_shmem / oc_sram"
        Tag <0xfa00000 0x1000> "main_sdhci1"
        Tag <0xfa10000 0x1000> "main_sdhci0"
        Tag <0xfa20000 0x1000> "main_sdhci2"
        Tag <0x2400000 0x400> "main_timer0"
        Tag <0x2410000 0x400> "main_timer1"
        Tag <0x2420000 0x400> "main_timer2"
        Tag <0x2430000 0x400> "main_timer3"
        Tag <0xfa08000 0x400> "main_sdhci1"
        Tag <0xfa18000 0x400> "main_sdhci0"
        Tag <0xfa28000 0x400> "main_sdhci2"
        Tag <0x20100000 0x400> "main_spi0"
        Tag <0x20110000 0x400> "main_spi1"
        Tag <0x20120000 0x400> "main_spi2"
        Tag <0x20130000 0x400> "main_spi3"
        Tag <0x28001000 0x400> "main_adc0"
        Tag <0x2b100000 0x400> "wkup_timer0"
        Tag <0x2b110000 0x400> "wkup_timer1"
        Tag <0x4084000 0x24c> "wkup_pinctrl"
        Tag <0x2810000 0x100> "main_uart1"
        Tag <0x2820000 0x100> "main_uart2"
        Tag <0x2830000 0x100> "main_uart3"
        Tag <0x2840000 0x100> "main_uart4"
        Tag <0x2850000 0x100> "main_uart5"
        Tag <0x2860000 0x100> "main_uart6"
        Tag <0xe000000 0x100> "main_rti0"
        Tag <0xe010000 0x100> "main_rti1"
        Tag <0xfc40000 0x100> "main_ospi0"
        Tag <0x20000000 0x100> "main_i2c0"
        Tag <0x20010000 0x100> "main_i2c1"
        Tag <0x20020000 0x100> "main_i2c2"
        Tag <0x20030000 0x100> "main_i2c3"
        Tag <0x23000000 0x100> "main_epwm0"
        Tag <0x23010000 0x100> "main_epwm1"
        Tag <0x23020000 0x100> "main_epwm2"
        Tag <0x23100000 0x100> "main_ecap0"
        Tag <0x23110000 0x100> "main_ecap1"
        Tag <0x23120000 0x100> "main_ecap2"
        Tag <0x2b200000 0x100> "wkup_i2c0"
        Tag <0x2b1f0000 0x64> "wkup_rtc0"
        Tag <0x600010 0x28> "main_gpio0_0"
        Tag <0x600038 0x28> "main_gpio0_1"
        Tag <0x600060 0x28> "main_gpio0_2"
        Tag <0x600088 0x28> "main_gpio0_3"
        Tag <0x4201010 0x28> "wkup_gpio0"
        Tag <0x60000000 0x4> "main_ospi0"

flash0memory: Memory.MappedMemory @ sysbus 0x60000000
    size: 0x4000000

sramall: Memory.MappedMemory @ sysbus 0x707f0000
    size: 0x24000

ddr0: Memory.MappedMemory @ sysbus 0x82000000
    size: 0x7e000000

// autogenerated

gic: IRQControllers.ARM_GenericInterruptController @ {
        sysbus new Bus.BusMultiRegistration { address: 0x1800000; size: 0x10000; region: "distributor" };
        sysbus new IRQControllers.ArmGicRedistributorRegistration { attachedCPU: cpu0; address: 0x1840000 }
    }
    architectureVersion: IRQControllers.ARM_GenericInterruptControllerVersion.GICv3

cpu0: CPU.ARMv8A @ sysbus
    cpuType: "cortex-a53"
    cpuId: 0x0
    genericInterruptController: gic

cpu0_timer: Timers.ARM_GenericTimer @ cpu0
    frequency: 200000000   // AM62L timebase (Zephyr dtsi: 200 MHz); dts2repl wrote 62.5 MHz
    EL3PhysicalTimerIRQ->gic#0x0@29
    EL1PhysicalTimerIRQ->gic#0x0@30
    EL1VirtualTimerIRQ->gic#0x0@27
    NonSecureEL2PhysicalTimerIRQ->gic#0x0@26

mainuart0: UART.NS16550 @ sysbus 0x2800000
    wideRegisters: true
    ->gic@96
