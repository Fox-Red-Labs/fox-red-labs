# Config fragment on top of TI SDK 12.01 arm64 defconfig (kernel 6.18.38).
# KVM: CPUs start at EL2 on this board (dmesg "All CPU(s) started at EL2").
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_VHOST_NET=m
CONFIG_VHOST_VSOCK=m
CONFIG_VSOCKETS=m
CONFIG_VIRTIO_VSOCKETS=m
CONFIG_BRIDGE=m
CONFIG_VETH=m
# Android binder (ashmem was removed upstream in 5.18; Android uses memfd)
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_MEMFD_CREATE=y
CONFIG_PSI=y
# binfmt_misc (qemu-user, Wine/box64 style handlers)
CONFIG_BINFMT_MISC=y
# Namespaces for Chromium/CEF sandbox, containers
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_IPC_NS=y
CONFIG_UTS_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
# Controllers (PS5/PS4 pads and uinput, found missing 2026-10-24)
CONFIG_HID_PLAYSTATION=m
CONFIG_HID_SONY=m
CONFIG_INPUT_UINPUT=m
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_LOCALVERSION="-ti-kvm"
