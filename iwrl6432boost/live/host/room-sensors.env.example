# /etc/room-sensors.env, read by radar-room.service and wifi-room.service. Root only (chmod 600): it holds tokens.
# Serial number of each board's XDS110 probe (ls /dev/serial/by-id shows it in the name).
RADAR_PROBE=RI32
WIFI_PORT=/dev/serial/by-id/usb-Texas_Instruments_XDS110__02.03.00.00__Embed_with_CMSIS-DAP_CHANGEME-if00
# This host's LAN address, to open the pages from a phone or laptop. Leave as 127.0.0.1 for this host only.
LAN_ADDR=127.0.0.1
# Home Assistant: a long-lived access token (HA profile page, Security). Leave empty to log locally only.
HA_URL=
HA_TOKEN=
# Wi-Fi board: the network it joins on first start. The board keeps streaming after that.
FRL_WIFI_SSID=
FRL_WIFI_PSK=
