[Unit]
Description=Radar people counting (IWRL6432BOOST): live page, all-day log, Home Assistant
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/room-sensors.env
WorkingDirectory=/opt/room-sensors/iwrl6432boost/live
ExecStart=/opt/room-sensors/iwrl6432boost/live/host/run.sh radar
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
