@@ -815,12 +815,29 @@ void ScummEngine::writeVar(uint var, int value) {
 	error("Illegal varbits (w)");
 }
 
+// Steam re-releases of the Backyard games (ticket #15412) run scripts that pop
+// past the bottom of the stack and push back up again. The original program has
+// no bounds check, so model the slots below zero with a small shadow area.
+static int g_vmStackUnder[256];
+
 void ScummEngine::push(int a) {
+	if (_scummStackPos < 0 && _scummStackPos >= -(int)ARRAYSIZE(g_vmStackUnder)) {
+		g_vmStackUnder[-_scummStackPos - 1] = a;
+		_scummStackPos++;
+		return;
+	}
 	assert(_scummStackPos >= 0 && _scummStackPos < ARRAYSIZE(_vmStack));
 	_vmStack[_scummStackPos++] = a;
 }
 
 int ScummEngine::pop() {
+	if (_scummStackPos <= 0 && _scummStackPos > -(int)ARRAYSIZE(g_vmStackUnder)) {
+		static int warned = 0;
+		if (warned++ < 5)
+			warning("pop: stack underflow (pos %d), original program tolerated it", _scummStackPos);
+		--_scummStackPos;
+		return g_vmStackUnder[-_scummStackPos - 1];
+	}
 	assert(_scummStackPos >= 1 && _scummStackPos <= ARRAYSIZE(_vmStack));
 	return _vmStack[--_scummStackPos];
 }
