/*
 * I2C controller and target on the same peripheral, joined inside the chip by the
 * loopback bit (I2C_MCR.LPBK, bit 8; the controller configuration register is at
 * offset 0x1228). No wires, no sensor. Pins PC2/PC3 (I2C2) stay configured with
 * pull-ups, as for the BoosterPack position.
 */
#include <zephyr/dt-bindings/pinctrl/mspm0-pinctrl.h>

&pinctrl {
	i2c2_scl_pc2: i2c2_scl_pc2 {
		pinmux = <MSP_PINMUX(76, MSPM0_PIN_FUNCTION_2)>;
		input-enable;
		drive-open-drain;
		bias-pull-up;
	};

	i2c2_sda_pc3: i2c2_sda_pc3 {
		pinmux = <MSP_PINMUX(77, MSPM0_PIN_FUNCTION_2)>;
		input-enable;
		drive-open-drain;
		bias-pull-up;
	};
};

&i2c2 {
	pinctrl-0 = <&i2c2_scl_pc2 &i2c2_sda_pc3>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;
	status = "okay";

	eeprom0: eeprom@54 {
		compatible = "zephyr,i2c-target-eeprom";
		reg = <0x54>;
		address-width = <8>;
		size = <256>;
	};
};
