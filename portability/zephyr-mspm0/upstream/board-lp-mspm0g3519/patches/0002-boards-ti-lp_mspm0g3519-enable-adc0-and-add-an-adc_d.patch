From c6be0d9515a4f92bf4539d7609eb05064a64dedf Mon Sep 17 00:00:00 2001
From: Contributor Name <contributor@example.invalid>
Date: Sun, 25 Oct 2026 07:12:11 -0400
Subject: [PATCH 2/3] boards: ti: lp_mspm0g3519: enable adc0 and add an adc_dt
 overlay

The ti,mspm0-adc12 binding requires clocks, ti,clk-range,
ti,clk-divider, max-result-reg and pinctrl-0, and no board enables the
node yet. Enable adc0 on the LP-MSPM0G3519 with ULPCLK (40 MHz), clock
range 32 to 40 MHz and divider 8 (5 MHz ADC clock), 12 result
registers, and PA25 (ADC0 channel 2) routed to the converter.

Add the adc_dt sample overlay for channel 2 and list the board in the
sample's tests.yaml. Add adc to the board's supported features.

Assisted-by: Claude:claude-sonnet-5-5
---
 boards/ti/lp_mspm0g3519/doc/index.rst         |  7 ++++++
 boards/ti/lp_mspm0g3519/lp_mspm0g3519.dts     | 12 ++++++++++
 boards/ti/lp_mspm0g3519/lp_mspm0g3519.yaml    |  1 +
 .../adc/adc_dt/boards/lp_mspm0g3519.overlay   | 24 +++++++++++++++++++
 samples/drivers/adc/adc_dt/tests.yaml         |  1 +
 5 files changed, 45 insertions(+)
 create mode 100644 samples/drivers/adc/adc_dt/boards/lp_mspm0g3519.overlay

diff --git a/boards/ti/lp_mspm0g3519/doc/index.rst b/boards/ti/lp_mspm0g3519/doc/index.rst
index b16ed0eaf..acf05d612 100644
--- a/boards/ti/lp_mspm0g3519/doc/index.rst
+++ b/boards/ti/lp_mspm0g3519/doc/index.rst
@@ -84,6 +84,13 @@ Supported Features
 
 .. zephyr:board-supported-hw::
 
+ADC
+===
+
+``adc0`` is enabled in the board file with the MSPM0 ADC12 clock settings (ULPCLK at 40 MHz,
+divided by 8) and with PA25, ADC0 channel 2, routed to the converter. Applications describe their
+channels in an overlay; see ``samples/drivers/adc/adc_dt/boards/lp_mspm0g3519.overlay``.
+
 Building and Flashing
 *********************
 
diff --git a/boards/ti/lp_mspm0g3519/lp_mspm0g3519.dts b/boards/ti/lp_mspm0g3519/lp_mspm0g3519.dts
index d1fe55d8e..863a9a141 100644
--- a/boards/ti/lp_mspm0g3519/lp_mspm0g3519.dts
+++ b/boards/ti/lp_mspm0g3519/lp_mspm0g3519.dts
@@ -156,3 +156,15 @@
 	pinctrl-0 = <&analog_pa23>;
 	pinctrl-names = "default";
 };
+
+&adc0 {
+	status = "okay";
+	#address-cells = <1>;
+	#size-cells = <0>;
+	clocks = <&ckm MSPM0_CLOCK_ULPCLK>;
+	ti,clk-range = <6>;	/* ULPCLK 40 MHz is in the 32 to 40 MHz range */
+	ti,clk-divider = <8>;	/* 5 MHz ADC clock */
+	max-result-reg = <12>;
+	pinctrl-0 = <&analog_pa25>;	/* ADC0 channel 2 */
+	pinctrl-names = "default";
+};
diff --git a/boards/ti/lp_mspm0g3519/lp_mspm0g3519.yaml b/boards/ti/lp_mspm0g3519/lp_mspm0g3519.yaml
index faa456b02..faffe893d 100644
--- a/boards/ti/lp_mspm0g3519/lp_mspm0g3519.yaml
+++ b/boards/ti/lp_mspm0g3519/lp_mspm0g3519.yaml
@@ -15,4 +15,5 @@ supported:
   - dac
   - spi
   - vref
+  - adc
 vendor: ti
diff --git a/samples/drivers/adc/adc_dt/boards/lp_mspm0g3519.overlay b/samples/drivers/adc/adc_dt/boards/lp_mspm0g3519.overlay
new file mode 100644
index 000000000..26845df90
--- /dev/null
+++ b/samples/drivers/adc/adc_dt/boards/lp_mspm0g3519.overlay
@@ -0,0 +1,24 @@
+/*
+ * Copyright (c) 2026 Texas Instruments
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <zephyr/dt-bindings/adc/adc.h>
+
+/ {
+	zephyr,user {
+		/* PA25, ADC0 channel 2 */
+		io-channels = <&adc0 2>;
+	};
+};
+
+&adc0 {
+	channel@2 {
+		reg = <2>;
+		zephyr,gain = "ADC_GAIN_1";
+		zephyr,reference = "ADC_REF_VDD_1";
+		zephyr,acquisition-time = <ADC_ACQ_TIME(ADC_ACQ_TIME_TICKS, 32)>;
+		zephyr,resolution = <12>;
+	};
+};
diff --git a/samples/drivers/adc/adc_dt/tests.yaml b/samples/drivers/adc/adc_dt/tests.yaml
index f4bb1c47a..4b3f1e36f 100644
--- a/samples/drivers/adc/adc_dt/tests.yaml
+++ b/samples/drivers/adc/adc_dt/tests.yaml
@@ -62,6 +62,7 @@ tests:
       - fpb_ra8e1
       - raytac_an54lv_db_15/nrf54l15/cpuapp
       - frdm_mcxl255/mcxl255/cpu0
+      - lp_mspm0g3519
     integration_platforms:
       - nucleo_l073rz
       - nrf52840dk/nrf52840
