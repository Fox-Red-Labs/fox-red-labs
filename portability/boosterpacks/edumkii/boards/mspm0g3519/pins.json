  "LED_GREEN": "PC4",
  "LED_BLUE": "PC5",
  "BUZZER": "PB3",
  "S1": "PA11",
  "S2": "PA12",
  "JOY_SEL": "PB29",
  "I2C_SCL": "PC2",
  "I2C_SDA": "PC3"
 },
 "spi": {
  "peripheral": "SPI1",
  "sclk": "PB31",
  "mosi": "PB8",
  "miso": "PB7",
