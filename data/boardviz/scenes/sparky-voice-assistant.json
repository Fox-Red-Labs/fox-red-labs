    }
   ]
  },
  {
   "title": "Press the Audio BoosterPack on",
   "text": "Press the BOOSTXL-AUDIO onto the LaunchPad headers J1 to J4 and leave its J5 jumper on SPI DAC, the way it ships. The pack's microphone and speaker use pins 5, 6, 7, 12, 13 and 15; none of the screen wires below touch them. You need no wire for voice alone: stop here if you have no screen.",
   "focus": "boostxl-audio.j1",
   "focus_label": "Sockets on the headers",
   "do": [
    {
     "view": {
      "azimuth": -0.9,
      "elevation": 0.8,
      "zoom": 0.95,
