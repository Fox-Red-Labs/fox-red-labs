       "pin:PB9",
       "gpiob",
       "cpu"
      ]
     ],
     "rows": [
      {
       "block": "gpiob",
       "step": "Asks the DHT11, reads 40 bits",
       "by": "GPIOB PB9, one wire, every 2 s"
      }
     ]
    },
    {
     "name": "Screen",
     "chains": [
      [
       "cpu",
       "gpiob",
       "pin:PB2",
       "part:oled"
      ],
      [
