  "hobby-button-knob-dim": {
   "title": "Button, knob and dimmer",
   "card_title": "Knob and dimmer",
   "card_line": "Turn a knob and an LED dims.",
   "status": "Builds here; ran on the MSPM0 G3519, a different board",
   "folder": "button-knob-dim",
   "flash": 3232,
   "ram": 712,
   "parts": {
    "knob": {
     "name": "Knob",
     "note": "10 kΩ pot, 3V3 to GND"
    },
    "led": {
     "name": "LED",
     "note": "330 Ω to GND"
    },
    "s2": {
     "name": "S2",
     "note": "button on the board"
    },
    "usb": {
     "name": "USB",
     "note": "serial through the probe"
    }
   },
   "pins": {
    "PA25": {
     "header": "J1 pin 2",
     "block": "adc0",
     "signal": "POT1"
    },
    "PB4": {
     "header": "J4 pin 40",
     "block": "tima1",
     "signal": "LED"
    },
    "PB21": {
     "header": "onboard",
     "block": "gpiob",
     "signal": "BTN_A"
    },
    "PA10": {
     "header": "J4 pin 34",
     "block": "uart0",
     "source": "portability/hobby/button-knob-dim/PINS.md"
    },
    "PB8": {
     "header": "J2 pin 15",
     "block": "gpiob",
     "signal": "BTN_B"
    }
   },
   "wiring": "Knob wiper to J1 pin 2 (PA25), its ends to J1 pin 1 (3V3) and J2 pin 20 (GND). LED anode through 330 Ω to J4 pin 40 (PB4), cathode to GND. S2 is on the board; optional: your own button on J2 pin 15 (PB8), other side to GND.",
   "jobs": [
    {
     "name": "Knob",
     "chains": [
      [
       "part:knob",
       "pin:PA25",
       "adc0",
       "cpu"
      ]
     ],
     "rows": [
      {
       "block": "pin:PA25",
       "step": "Takes the knob voltage",
       "by": "PA25, J1 pin 2"
      },
      {
       "block": "adc0",
       "step": "Reads the knob",
       "by": "ADC0 ch 2, 12 bit"
      }
     ]
    },
    {
     "name": "Dimmer",
     "chains": [
      [
       "cpu",
       "tima1",
       "pin:PB4",
       "part:led"
      ]
     ],
     "rows": [
      {
       "block": "tima1",
       "step": "Turns it into a pulse width",
       "by": "TIMA1 CC0, 1 kHz"
      },
      {
       "block": "pin:PB4",
       "step": "Dims the LED",
       "by": "PB4, J4 pin 40"
      }
     ]
    },
    {
     "name": "Button",
     "chains": [
      [
       "part:s2",
       "pin:PB21",
       "gpiob",
       "cpu"
      ]
     ],
     "rows": [
      {
       "block": "gpiob",
       "step": "Notices a press of S2",
       "by": "GPIOB PB21, pull-up, 20 ms debounce"
      }
     ]
    },
    {
     "name": "Console",
     "chains": [
      [
       "cpu",
       "uart0",
       "pin:PA10",
       "part:usb"
      ]
     ],
     "rows": [
      {
       "block": "uart0",
       "step": "Prints the values",
       "by": "UART0 TX, 115200"
      },
      {
       "block": "pin:PA10",
       "step": "Sends it to your computer",
       "by": "PA10, J4 pin 34, through the probe"
      }
     ]
    },
    {
     "name": "Time",
     "chains": [
      [
       "systick",
       "cpu"
      ]
     ],
     "rows": [
      {
       "block": "systick",
       "step": "Times the 5 ms pauses",
       "by": "SysTick, the CPU's own counter"
      }
     ]
    }
   ],
   "tags": {
    "adc0": "ch 2",
    "tima1": "CC0 1 kHz",
    "gpiob": "PB21 in",
    "uart0": "TX 115200",
    "systick": "timebase"
   }
  },
