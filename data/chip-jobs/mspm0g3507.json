       "pin:PB3",
       "part:oled"
      ]
     ],
     "rows": [
      {
       "block": "gpiob",
       "step": "Draws it on the OLED",
       "by": "GPIOB PB2, PB3 as I2C by hand"
      }
     ]
    },
    {
     "name": "Time",
     "chains": [
      [
       "systick",
       "cpu"
      ]
     ],
     "rows": [
      {
