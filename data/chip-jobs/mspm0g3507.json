  "hobby-parking-sensor": {
   "title": "Parking sensor",
   "card_title": "Parking sensor",
   "card_line": "A buzzer beeps faster as you get close.",
   "status": "Builds here; not run on a board",
   "folder": "parking-sensor",
   "flash": 3224,
   "ram": 524,
   "parts": {
    "sensor": {
     "name": "Ultrasonic",
     "note": "RCWL-1601 at 3.3 V"
    },
    "buzzer": {
     "name": "Buzzer",
     "note": "passive"
    },
    "usb": {
     "name": "USB",
     "note": "serial through the probe"
    }
   },
   "pins": {
    "PB13": {
     "header": "J4 pin 35",
     "block": "gpiob",
     "signal": "TRIG"
    },
    "PB20": {
     "header": "J4 pin 36",
     "block": "gpiob",
     "signal": "ECHO"
    },
    "PB7": {
     "header": "J2 pin 14",
     "block": "timg8",
     "signal": "BUZZ"
    },
    "PA10": {
     "header": "J4 pin 34",
     "block": "uart0",
     "source": "portability/hobby/parking-sensor/PINS.md"
    }
   },
   "wiring": "Sensor TRIG to J4 pin 35 (PB13), ECHO to J4 pin 36 (PB20), VCC to J1 pin 1 (3V3), GND to J2 pin 20 (GND). Buzzer to J2 pin 14 (PB7), its other leg to GND.",
   "jobs": [
    {
     "name": "Ping",
     "chains": [
      [
       "cpu",
       "gpiob",
       "pin:PB13",
       "part:sensor"
      ]
     ],
     "rows": [
      {
       "block": "gpiob",
       "step": "Sends a ping ten times a second",
       "by": "GPIOB PB13, a 12 us pulse"
      }
     ]
    },
    {
     "name": "Echo",
     "chains": [
      [
       "part:sensor",
       "pin:PB20",
       "gpiob",
       "cpu"
      ]
     ],
     "rows": [
      {
       "block": "gpiob",
       "step": "Waits for the echo",
       "by": "GPIOB PB20, high until it returns"
      }
     ]
    },
    {
     "name": "Stopwatch",
     "chains": [
      [
       "systick",
       "cpu"
      ]
     ],
     "rows": [
      {
       "block": "systick",
       "step": "Times it: cm = echo us / 58",
       "by": "SysTick, microseconds"
      }
     ]
    },
    {
     "name": "Beeper",
     "chains": [
      [
       "cpu",
       "timg8",
       "pin:PB7",
       "part:buzzer"
      ]
     ],
     "rows": [
      {
       "block": "timg8",
       "step": "Beeps faster as you near",
       "by": "TIMG8 CC1, 2 kHz, PB7 J2 pin 14"
      }
     ]
    },
    {
     "name": "Console",
     "chains": [
      [
       "cpu",
       "uart0",
       "pin:PA10",
       "part:usb"
      ]
     ],
     "rows": [
      {
       "block": "uart0",
       "step": "Prints the distance",
       "by": "UART0 TX, 115200"
      },
      {
       "block": "pin:PA10",
       "step": "Sends it to your computer",
       "by": "PA10, J4 pin 34, through the probe"
      }
     ]
    }
   ],
