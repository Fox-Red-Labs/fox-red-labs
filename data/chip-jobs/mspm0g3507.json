     "header": "LED1 on the board",
     "block": "gpioa",
     "source": "data/boardviz/mspm0g3507.json"
    }
   },
   "wiring": "Nothing to wire. LED1 is on the board.",
   "jobs": [
    {
     "name": "Blink",
     "chains": [
      [
       "cpu",
       "gpioa",
       "pin:PA0",
       "part:led1"
      ]
     ],
     "rows": [
      {
       "block": "cpu",
       "step": "Waits, then flips the pin",
       "by": "CPU, counting cycles"
      },
      {
       "block": "gpioa",
       "step": "Drives the pin high, then low",
       "by": "GPIOA pin 0"
      },
      {
       "block": "pin:PA0",
       "step": "Lights LED1",
       "by": "PA0, on the board"
      }
     ]
    }
   ],
