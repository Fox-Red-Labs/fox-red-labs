      [
       "gpiob",
       "pin:PB27",
       "part:grn"
      ]
     ],
     "rows": [
      {
       "block": "gpiob",
       "step": "Switches the lamps in turn",
       "by": "GPIOB PB26, PB10, PB27"
      }
     ]
    },
    {
     "name": "Tune",
