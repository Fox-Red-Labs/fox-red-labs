      [
       "cpu",
       "timg8",
       "pin:PB7",
       "part:buzzer"
      ]
     ],
     "rows": [
      {
       "block": "timg8",
       "step": "Beeps faster as you near",
       "by": "TIMG8 CC1, 2 kHz, PB7 J2 pin 14"
      }
     ]
    },
    {
     "name": "Console",
     "chains": [
      [
       "cpu",
       "uart0",
       "pin:PA10",
       "part:usb"
      ]
