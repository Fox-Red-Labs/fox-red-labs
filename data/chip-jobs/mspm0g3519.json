 "builds": {
  "hobby-button-knob-dim": {
   "title": "Button, knob and dimmer",
   "card_title": "Knob and dimmer",
   "card_line": "Turn a knob and an LED dims.",
   "status": "Ran on this board; checked through the debugger",
   "folder": "button-knob-dim",
   "flash": 3256,
   "ram": 456,
   "parts": {
    "knob": {
     "name": "Knob",
     "note": "10 kΩ pot, 3V3 to GND"
    },
    "led": {
     "name": "LED2 green",
     "note": "on the board"
    },
    "s2": {
     "name": "S2",
     "note": "button on the board"
    },
    "usb": {
     "name": "USB",
     "note": "serial through the probe"
    }
   },
   "pins": {
    "PA14": {
     "header": "J1 pin 2",
     "block": "adc0",
     "signal": "POT1"
    },
    "PB27": {
     "header": "J3 pin 28",
     "block": "tima1",
     "signal": "LED"
    },
    "PB3": {
     "header": "J4 pin 40",
     "block": "gpiob",
     "signal": "BTN_A"
    },
    "PA10": {
     "header": "J4 pin 34",
     "block": "uart0",
     "source": "portability/hobby/button-knob-dim/PINS.md"
    },
    "PB8": {
     "header": "J2 pin 15",
     "block": "gpiob",
     "signal": "BTN_B"
    }
   },
   "wiring": "Knob wiper to J1 pin 2 (PA14), its ends to J1 pin 1 (3V3) and J2 pin 20 (GND). The LED is LED2 green on the board, J3 pin 28 (PB27); an outside LED through 330 Ω works there too. S2 is on the board, J4 pin 40 (PB3); optional: your own button on J2 pin 15 (PB8), other side to GND.",
   "jobs": [
    {
     "name": "Knob",
     "chains": [
      [
       "part:knob",
       "pin:PA14",
       "adc0",
       "cpu"
      ]
     ],
     "rows": [
      {
       "block": "pin:PA14",
       "step": "Takes the knob voltage",
       "by": "PA14, J1 pin 2"
      },
      {
       "block": "adc0",
       "step": "Reads the knob",
       "by": "ADC0 ch 12, 12 bit"
      }
     ]
    },
    {
     "name": "Dimmer",
     "chains": [
      [
       "cpu",
       "tima1",
       "pin:PB27",
       "part:led"
      ]
     ],
     "rows": [
      {
       "block": "tima1",
       "step": "Turns it into a pulse width",
       "by": "TIMA1 CC1, 1 kHz"
      },
      {
       "block": "pin:PB27",
       "step": "Dims the LED",
       "by": "PB27, J3 pin 28"
      }
     ]
    },
    {
     "name": "Button",
     "chains": [
      [
       "part:s2",
       "pin:PB3",
       "gpiob",
       "cpu"
      ]
     ],
     "rows": [
      {
       "block": "gpiob",
       "step": "Notices a press of S2",
       "by": "GPIOB PB3, pull-up, 20 ms debounce"
      }
     ]
    },
    {
     "name": "Console",
     "chains": [
      [
       "cpu",
       "uart0",
       "pin:PA10",
       "part:usb"
      ]
     ],
     "rows": [
      {
       "block": "uart0",
       "step": "Prints the values",
       "by": "UART0 TX, 115200"
      },
      {
       "block": "pin:PA10",
       "step": "Sends it to your computer",
       "by": "PA10, J4 pin 34, through the probe"
      }
     ]
    },
    {
     "name": "Time",
     "chains": [
      [
       "systick",
       "cpu"
      ]
     ],
     "rows": [
      {
       "block": "systick",
       "step": "Times the 5 ms pauses",
       "by": "SysTick, the CPU's own counter"
      }
     ]
    }
   ],
   "tags": {
    "adc0": "ch 12",
    "tima1": "CC1 1 kHz",
    "gpiob": "PB3 in",
    "uart0": "TX 115200",
    "systick": "timebase"
   }
  },
  "hobby-led-sequences": {
