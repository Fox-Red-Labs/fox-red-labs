    },
    "usb": {
     "name": "USB",
     "note": "serial through the probe"
    }
   },
   "pins": {
    "PB5": {
     "header": "J4 pin 35",
     "block": "gpiob",
     "signal": "TRIG"
    },
    "PB4": {
     "header": "J4 pin 36",
     "block": "gpiob",
     "signal": "ECHO"
