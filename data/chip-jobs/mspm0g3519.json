     "source": "portability/hobby/parking-sensor/PINS.md"
    }
   },
   "wiring": "Sensor TRIG to J4 pin 35 (PB5), ECHO to J4 pin 36 (PB4), VCC to J1 pin 1 (3V3), GND to J2 pin 20 (GND). Buzzer to J2 pin 14 (PB7), its other leg to GND.",
   "jobs": [
    {
     "name": "Ping",
     "chains": [
      [
       "cpu",
       "gpiob",
       "pin:PB5",
       "part:sensor"
      ]
     ],
     "rows": [
      {
       "block": "gpiob",
       "step": "Sends a ping ten times a second",
       "by": "GPIOB PB5, a 12 us pulse"
      }
     ]
    },
    {
     "name": "Echo",
     "chains": [
      [
       "part:sensor",
       "pin:PB4",
       "gpiob",
       "cpu"
      ]
     ],
     "rows": [
      {
       "block": "gpiob",
       "step": "Waits for the echo",
       "by": "GPIOB PB4, high until it returns"
      }
     ]
    },
    {
     "name": "Stopwatch",
     "chains": [
      [
       "systick",
       "cpu"
      ]
     ],
     "rows": [
      {
       "block": "systick",
       "step": "Times it: cm = echo us / 58",
       "by": "SysTick, microseconds"
      }
     ]
    },
    {
     "name": "Beeper",
