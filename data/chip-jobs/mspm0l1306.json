  "hobby-weather-station": {
   "title": "Room weather station",
   "card_title": "Weather station",
   "card_line": "Temperature and humidity on a small screen.",
   "status": "Builds here; not run on a board",
   "folder": "weather-station",
   "flash": 8104,
   "ram": 545,
   "parts": {
    "dht": {
     "name": "DHT11",
     "note": "temperature, humidity"
    },
    "oled": {
     "name": "OLED",
     "note": "128x64, I2C 0x3C"
    },
    "usb": {
     "name": "USB",
     "note": "serial through the probe"
    }
   },
   "pins": {
    "PA6": {
     "header": "J1 pin 7",
     "block": "gpioa",
     "signal": "DHT"
    },
    "PA1": {
     "header": "J1 pin 9",
     "block": "gpioa",
     "signal": "SCL"
    },
    "PA0": {
     "header": "J1 pin 10",
     "block": "gpioa",
     "signal": "SDA"
    },
    "PA8": {
     "header": "J1 pin 4",
     "block": "uart0",
     "source": "portability/hobby/weather-station/PINS.md"
    }
   },
   "wiring": "DHT11 DATA to J1 pin 7 (PA6). OLED SCL to J1 pin 9 (PA1), SDA to J1 pin 10 (PA0). Both to 3V3 and GND. PA0 and PA1 have no internal pull-up: pull jumper J2 (LED1 is on PA0), and put J9 and J10 to the 3V3 side or rely on the module's own pull-ups. A bare DHT11 needs 4.7 to 10 kΩ from DATA to 3V3; the 3-pin module has it.",
   "jobs": [
    {
     "name": "Read sensor",
     "chains": [
      [
       "cpu",
       "gpioa",
       "pin:PA6",
       "part:dht"
      ],
      [
       "part:dht",
       "pin:PA6",
       "gpioa",
       "cpu"
      ]
     ],
     "rows": [
      {
       "block": "gpioa",
       "step": "Asks the DHT11, reads 40 bits",
       "by": "GPIOA PA6, one wire, every 2 s"
      }
     ]
    },
    {
     "name": "Screen",
     "chains": [
      [
       "cpu",
       "gpioa",
       "pin:PA1",
       "part:oled"
      ],
      [
       "gpioa",
       "pin:PA0",
       "part:oled"
      ]
     ],
     "rows": [
      {
       "block": "gpioa",
       "step": "Draws it on the OLED",
       "by": "GPIOA PA1, PA0 as I2C by hand"
      }
     ]
    },
    {
     "name": "Time",
     "chains": [
      [
       "systick",
       "cpu"
      ]
     ],
     "rows": [
      {
       "block": "systick",
       "step": "Times the sensor pulses and the I2C clock",
       "by": "SysTick, the CPU's own counter"
      }
     ]
    },
    {
     "name": "Console",
     "chains": [
      [
       "cpu",
       "uart0",
       "pin:PA8",
       "part:usb"
      ]
     ],
     "rows": [
      {
       "block": "uart0",
       "step": "Prints temperature and humidity",
       "by": "UART0 TX, 115200"
      },
      {
       "block": "pin:PA8",
       "step": "Sends it to your computer",
       "by": "PA8, J1 pin 4, through the probe"
      }
     ]
    }
   ],
   "tags": {
    "gpioa": "PA6 PA1 PA0",
    "uart0": "TX 115200",
    "systick": "timebase"
   },
   "near": {
    "i2c": "Its pins PA0 and PA1 are used as plain GPIO here: this build does the I2C itself to stay small."
   }
