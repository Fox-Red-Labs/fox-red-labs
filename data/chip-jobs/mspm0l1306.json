  "hobby-button-knob-dim": {
   "title": "Button, knob and dimmer",
   "card_title": "Knob and dimmer",
   "card_line": "Turn a knob and an LED dims.",
   "status": "Builds here; ran on the MSPM0 G3519, a different board",
   "folder": "button-knob-dim",
   "flash": 3192,
   "ram": 268,
   "parts": {
    "knob": {
     "name": "Knob",
     "note": "10 kΩ pot, 3V3 to GND"
    },
    "led": {
     "name": "LED",
     "note": "330 Ω to GND"
    },
    "s2": {
     "name": "S2",
     "note": "button on the board"
    },
    "usb": {
     "name": "USB",
     "note": "serial through the probe"
    }
   },
   "pins": {
    "PA25": {
     "header": "J1 pin 2",
     "block": "adc0",
     "signal": "POT1"
    },
    "PA12": {
     "header": "J4 pin 40",
     "block": "timg0",
     "signal": "LED"
    },
    "PA14": {
     "header": "onboard",
     "block": "gpioa",
     "signal": "BTN_A"
    },
    "PA8": {
     "header": "J1 pin 4",
     "block": "uart0",
     "source": "portability/hobby/button-knob-dim/PINS.md"
    },
    "PA5": {
     "header": "J2 pin 15",
     "block": "gpioa",
     "signal": "BTN_B"
    }
   },
   "wiring": "Knob wiper to J1 pin 2 (PA25), its ends to J1 pin 1 (3V3) and J2 pin 20 (GND). LED anode through 330 Ω to J4 pin 40 (PA12), cathode to GND. S2 is on the board; optional: your own button on J2 pin 15 (PA5), other side to GND.",
   "jobs": [
    {
     "name": "Knob",
     "chains": [
      [
       "part:knob",
       "pin:PA25",
       "adc0",
       "cpu"
      ]
     ],
     "rows": [
      {
       "block": "pin:PA25",
       "step": "Takes the knob voltage",
       "by": "PA25, J1 pin 2"
      },
      {
       "block": "adc0",
       "step": "Reads the knob",
       "by": "ADC0 ch 2, 12 bit"
      }
     ]
    },
    {
     "name": "Dimmer",
     "chains": [
      [
       "cpu",
       "timg0",
       "pin:PA12",
       "part:led"
      ]
     ],
     "rows": [
      {
       "block": "timg0",
       "step": "Turns it into a pulse width",
       "by": "TIMG0 CC0, 1 kHz"
      },
      {
       "block": "pin:PA12",
       "step": "Dims the LED",
       "by": "PA12, J4 pin 40"
      }
     ]
    },
    {
     "name": "Button",
     "chains": [
      [
       "part:s2",
       "pin:PA14",
       "gpioa",
       "cpu"
      ]
     ],
     "rows": [
      {
       "block": "gpioa",
       "step": "Notices a press of S2",
       "by": "GPIOA PA14, pull-up, 20 ms debounce"
      }
     ]
    },
    {
     "name": "Console",
     "chains": [
      [
       "cpu",
       "uart0",
       "pin:PA8",
       "part:usb"
      ]
     ],
     "rows": [
      {
       "block": "uart0",
       "step": "Prints the values",
       "by": "UART0 TX, 115200"
      },
      {
       "block": "pin:PA8",
       "step": "Sends it to your computer",
       "by": "PA8, J1 pin 4, through the probe"
      }
     ]
    },
    {
     "name": "Time",
     "chains": [
      [
       "systick",
       "cpu"
      ]
     ],
     "rows": [
      {
       "block": "systick",
       "step": "Times the 5 ms pauses",
       "by": "SysTick, the CPU's own counter"
      }
     ]
    }
   ],
   "tags": {
    "adc0": "ch 2",
    "timg0": "CC0 1 kHz",
    "gpioa": "PA14 in",
    "uart0": "TX 115200",
    "systick": "timebase"
   }
  },
