 }
 
+/* Fox Red Labs: read the chip temperature (whole degrees C from TI's driver) into the ZCL attribute,
+   in hundredths of a degree, and tell the reporting engine when it changed. */
+static void frlReadTemperature(bool notify)
+{
+    int16_t c = Temperature_getTemperature();
+    int16_t v = (int16_t)(c * 100);
+    frlSamples++;
+    if (v != zclSampleTemperatureSensor_MeasuredValue)
+    {
+        zclSampleTemperatureSensor_MeasuredValue = v;
+#ifdef BDB_REPORTING
+        if (notify)
+        {
+            zstack_bdbRepChangedAttrValueReq_t Req;
+            Req.attrID = ATTRID_TEMPERATURE_MEASUREMENT_MEASURED_VALUE;
+            Req.cluster = ZCL_CLUSTER_ID_MS_TEMPERATURE_MEASUREMENT;
+            Req.endpoint = SAMPLETEMPERATURESENSOR_ENDPOINT;
+            Zstackapi_bdbRepChangedAttrValueReq(appServiceTaskId, &Req);
+        }
+#endif
+    }
+}
+
+/* Fox Red Labs: ask the stack which poll period it is using, for the status line */
+static void frlReadPollRate(void)
+{
+    zstack_sysConfigReadReq_t req = {0};
+    zstack_sysConfigReadRsp_t rsp = {0};
+    req.pollRate = true;
+    if (Zstackapi_sysConfigReadReq(appServiceTaskId, &req, &rsp) == zstack_ZStatusValues_ZSuccess && rsp.has_pollRate)
+    {
+        frlPollMs = rsp.CurrentPollRate;
+    }
+}
