+	uint32_t pixels_w[160 / 4];
+	uint8_t *const pixels = (uint8_t *)pixels_w;
+	{
+		uint32_t zero = 0;
+#if defined(__GNUC__)
+		__asm__ volatile("" : "+r"(zero));
+#endif
+		for(unsigned zi = 0; zi < 160 / 4; zi++)
+			pixels_w[zi] = zero;
+	}
 
