--- a/freertos/basic_ble.syscfg	2026-10-12 20:04:05
+++ b/freertos/basic_ble.syscfg	2026-10-12 20:10:41
@@ -52,23 +52,36 @@
 ble.basicBLE = true;
 ble.disDevBySerUuid = true;
 ble.maxConnNum = 1;
-ble.deviceName = "Basic BLE project";
+ble.deviceName = "FRL Remote";
+// Bond manager (ports/ble-hid-remote): the HID over GATT Profile wants an encrypted, bonded link.
+// Wait for the host to pair: Apple's Accessory Design Guidelines (58.10) say an accessory should not
+// request pairing until an ATT request has been refused with Insufficient Authentication, which the
+// encrypted HID characteristics do. Just Works (no display, no keyboard on the board),
+// LE Secure Connections allowed, bonds kept in flash so the host reconnects without pairing again.
+ble.bondPairing = "GAPBOND_PAIRING_MODE_WAIT_FOR_REQ";
+ble.bondMITMProtection = false;
+ble.bondIOCaps = "GAPBOND_IO_CAP_NO_INPUT_NO_OUTPUT";
+ble.bonding = true;
+ble.secureConn = "GAPBOND_SECURE_CONNECTION_ALLOW";
 ble.numOfAdvSets = 1;
 // Gap Advertising Flags
 ble.advSet1.advData1.GAP_ADTYPE_FLAGS = true;
 ble.advSet1.advData1.advertisingFlags = ["GAP_ADTYPE_FLAGS_BREDR_NOT_SUPPORTED","GAP_ADTYPE_FLAGS_GENERAL"];
-// More 16-bit UUIDs available
-ble.advSet1.advData1.GAP_ADTYPE_16BIT_MORE = true;
-ble.advSet1.advData1.numOfUUIDs16More = 1;
-ble.advSet1.advData1.UUID016More = 65520;
+// Appearance: Generic HID (0x03C0). This template writes it low byte first, as the air wants.
+ble.advSet1.advData1.GAP_ADTYPE_APPEARANCE = true;
+ble.advSet1.advData1.appearanceValue = 0x03C0;
+// Complete list of 16-bit service UUIDs: HID (0x1812) and Battery (0x180F). Also written low byte first.
+ble.advSet1.advData1.GAP_ADTYPE_16BIT_COMPLETE = true;
+ble.advSet1.advData1.numOfUUIDs16Complete = 2;
+ble.advSet1.advData1.UUID016Complete = 0x1812;
+ble.advSet1.advData1.UUID116Complete = 0x180F;
 // Complete local name
 ble.advSet1.scanRes1.GAP_ADTYPE_LOCAL_NAME_COMPLETE = true;
 const connIntervalRange = system.getScript("/ti/ble/ble_common.js").getPeripheralConnIntervalRange();
 ble.advSet1.scanRes1[connIntervalRange] = true;
-// Min Connection Interval
-ble.advSet1.scanRes1.minConnInterval = 100;
-// Max Connection Interval
-ble.advSet1.scanRes1.maxConnInterval = 130;
+// Preferred connection interval 15 to 30 ms (was 100 to 130 ms): a key press waits for the next connection event
+ble.advSet1.scanRes1.minConnInterval = 15;
+ble.advSet1.scanRes1.maxConnInterval = 30;
 // TX Power Level
 ble.advSet1.scanRes1.GAP_ADTYPE_POWER_LEVEL = true;
 
