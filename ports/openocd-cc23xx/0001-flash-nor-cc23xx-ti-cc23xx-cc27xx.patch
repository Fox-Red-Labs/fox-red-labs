diff --git a/tcl/target/ti_cc23xx.cfg b/tcl/target/ti_cc23xx.cfg
new file mode 100644
index 000000000..fb5ed4df6
--- /dev/null
+++ b/tcl/target/ti_cc23xx.cfg
@@ -0,0 +1,53 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+#
+# TI SimpleLink CC23xx wireless MCU (Cortex-M0+), e.g. CC2340R5 (512 kB), CC2340R2 (256 kB).
+# SWD only. The debug port starts dormant; OpenOCD's SWD connect falls back to the
+# dormant-to-SWD wake by itself.
+#
+# Flash banks (driver cc23xx):
+#   main 0x00000000, 512 kB (CC2340R5) or 256 kB (CC2340R2), written through the boot ROM
+#   CCFG 0x4E020000: never erased or changed; an image that carries it
+#        programs only when it equals what the chip holds. CC23xx has no SCFG and no HSM area
+# Reset goes through SACI (cc23xx saci_reset): halt at the application entry, or run.
+
+source [find target/swj-dp.tcl]
+
+if { [info exists CHIPNAME] } {
+	set _CHIPNAME $CHIPNAME
+} else {
+	set _CHIPNAME cc23x0
+}
+
+# DPIDR not read on a CC23xx yet: accept any (0 = no check)
+if { [info exists CPUTAPID] } {
+	set _CPUTAPID $CPUTAPID
+} else {
+	set _CPUTAPID 0
+}
+
+if { [info exists WORKAREASIZE] } {
+	set _WORKAREASIZE $WORKAREASIZE
+} else {
+	set _WORKAREASIZE 0x2000
+}
+
+transport select swd
+
+swj_newdap $_CHIPNAME cpu -expected-id $_CPUTAPID
+dap create $_CHIPNAME.dap -tap $_CHIPNAME.cpu
+
+set _TARGETNAME $_CHIPNAME.cpu
+# AP0 is the AHB-AP (CPU, Cortex-M0+), AP1 the configuration port, AP2 the security port (SACI)
+target create $_TARGETNAME cortex_m -dap $_CHIPNAME.dap -ap-num 0
+$_TARGETNAME configure -work-area-phys 0x20000000 -work-area-size $_WORKAREASIZE -work-area-backup 0
+
+set _FLASHNAME $_CHIPNAME.flash
+flash bank $_FLASHNAME.main cc23xx 0x00000000 0 0 0 $_TARGETNAME
+flash bank $_FLASHNAME.ccfg cc23xx 0x4E020000 0 0 0 $_TARGETNAME
+
+# No reset pin on the debug header path; reset through SACI as TI's CCStudio does.
+$_TARGETNAME configure -event reset-assert { cc23xx saci_reset }
+
+# OpenOCD leaves an SWJ-DP in JTAG state when it exits; these chips power up dormant and TI's
+# CCStudio and UniFlash then cannot connect (Error -615). Put the port back to dormant first.
+lappend pre_shutdown_commands {catch {cc23xx dormant}}
