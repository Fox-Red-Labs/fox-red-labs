+// SysConfig 1.26.3 writes a 128-bit UUID into the packet in the order given, so the values below are the UUID text with its bytes reversed (the air wants the low byte first).
+// nRF Blinky lists only devices that advertise the LED Button Service UUID and have a name.
+// The advertisement carries flags (3 bytes) and the 128-bit UUID (18 bytes); the name goes in the scan response.
+ble.advSet1.advData1.GAP_ADTYPE_16BIT_MORE = false; // on by default
+ble.advSet1.advData1.GAP_ADTYPE_128BIT_COMPLETE = true;
+ble.advSet1.advData1.numOfUUIDs128Complete = 1;
