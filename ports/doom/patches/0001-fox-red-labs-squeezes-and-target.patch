+static long fox_peak_tag[128], fox_peak_tag_n[128];
+static void *fox_peak_site[256]; static long fox_peak_site_sum[256], fox_peak_site_n[256]; static int fox_peak_nsite;
+void fox_limits_print(void);
+static void fox_zstats_report(void)
+{
+    fox_limits_print();
+    printf("ZSTATS calls=%ld peak_all_bytes=%ld peak_nonpurgeable_bytes=%ld peak_blocks=%ld (each used block = request rounded up to 4 plus a 24-byte header; request sizes are those of this build, so only a 32-bit build gives the board numbers)\n",
+           fox_calls, fox_hw_all, fox_hw_static, fox_hw_blocks);
+    { int i; for (i = 0; i < fox_peak_nsite; i++) printf("ZSITE ra=%p blocks=%ld bytes=%ld\n", fox_peak_site[i], fox_peak_site_n[i], fox_peak_site_sum[i]); }
+    { int t; for (t = 0; t < 128; t++) if (fox_peak_tag_n[t]) printf("ZSTATS_AT_PEAK_NONPURGEABLE tag=%d blocks=%ld bytes=%ld\n", t, fox_peak_tag_n[t], fox_peak_tag[t]); }
+}
+static void fox_zstats_update(void)
+{
+    memblock_t *b; long all = 0, st = 0, n = 0; long tg[128] = {0}, tn[128] = {0};
+    if (!fox_registered) { atexit(fox_zstats_report); fox_registered = 1;
+#ifdef FOX_HOST
+        fox_zlog = getenv("ZSTATS_LOG") != NULL;
+#endif
+    }
+    fox_calls++;
+    for (b = mainzone->blocklist.next; b != &mainzone->blocklist; b = b->next)
+    {
+        long c;
+        if (b->tag == PU_FREE) continue;
+        c = ((b->req + 3) & ~3) + 24;
+        all += c; n++;
+        if (b->tag < PU_PURGELEVEL) { st += c; tg[b->tag] += c; tn[b->tag]++; }
+    }
+    if (all > fox_hw_all) fox_hw_all = all;
+    if (st > fox_hw_static) {
+        int i, ns = 0; void *sites[256]; long sums[256], ns_n[256];
+        for (b = mainzone->blocklist.next; b != &mainzone->blocklist; b = b->next)
+        {
+            if (b->tag == PU_FREE || b->tag >= PU_PURGELEVEL) continue;
+            for (i = 0; i < ns; i++) if (sites[i] == b->site) break;
+            if (i == ns) { if (ns == 256) continue; sites[ns] = b->site; sums[ns] = 0; ns_n[ns] = 0; ns++; }
+            sums[i] += ((b->req + 3) & ~3) + 24; ns_n[i]++;
+        }
+        memcpy(fox_peak_site, sites, sizeof(void *) * ns); memcpy(fox_peak_site_sum, sums, sizeof(long) * ns); memcpy(fox_peak_site_n, ns_n, sizeof(long) * ns); fox_peak_nsite = ns;
+        fox_hw_static = st; memcpy(fox_peak_tag, tg, sizeof tg); memcpy(fox_peak_tag_n, tn, sizeof tn); }
+    if (n > fox_hw_blocks) fox_hw_blocks = n;
+}
+#endif
